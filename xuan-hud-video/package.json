{
  "name": "xuan-hud-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-srt-catalog.mjs",
    "lint:gates": "node scripts/lint-gates.mjs",
    "check": "tsc --noEmit && node scripts/lint-gates.mjs && node scripts/verify-srt-catalog.mjs",
    "still": "remotion still src/index.ts",
    "sample": "remotion render src/index.ts --scale=1 --crf=20 --concurrency=8 --frames=0-1269",
    "preview": "remotion render src/index.ts --scale=1 --crf=20 --concurrency=8",
    "render:4k": "remotion render src/index.ts --scale=2 --crf=18 --max-rate=18M --buffer-size=36M --concurrency=8",
    "qc": "bash scripts/qc.sh",
    "regression:v31": "bash scripts/regression-v31.sh",
    "motion-strip": "bash scripts/motion-strip.sh"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.290",
    "@remotion/cli": "^4.0.290",
    "@remotion/media-utils": "^4.0.290"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
